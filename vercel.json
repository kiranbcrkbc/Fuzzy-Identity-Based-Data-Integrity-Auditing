{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/user", "destination": "/public/user.html" },
    { "source": "/kgc", "destination": "/public/kgc.html" },
    { "source": "/tpa", "destination": "/public/tpa.html" },
    { "source": "/cloud", "destination": "/public/cloud.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
